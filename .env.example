# ==========================================
# Telecaller CRM SaaS Environment Configuration
# ==========================================

# Django Core
DJANGO_SECRET_KEY=telecaller-crm-super-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# Database Engine: 'sqlite' or 'mysql'
DB_ENGINE=sqlite

# MySQL Configuration (When DB_ENGINE=mysql)
DB_NAME=telecaller_crm
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Initial Super Admin Seed (Used by create_super_admin command)
SUPERADMIN_EMAIL=superadmin@telecaller.crm
SUPERADMIN_PASSWORD=SuperAdmin123!

# JWT Lifetime Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Background Worker Settings
REMINDER_WORKER_INTERVAL_SECONDS=60
